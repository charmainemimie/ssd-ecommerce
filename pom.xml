<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The Boot parent pins compatible versions of every Spring/third-party
         dependency, so we don't manage those versions by hand. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ssd</groupId>
    <artifactId>catalog</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>catalog</name>
    <description>E-commerce backend: product catalog (spec: docs/spec/catalog/spec.md)</description>

    <properties>
        <!-- Target Java 21 bytecode/APIs even when built on a newer JDK,
             so nothing newer than the agreed stack sneaks in. -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- REST endpoints (Spring MVC + embedded Tomcat + Jackson). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Provides GET /actuator/health (spec Part 2 §1, operational endpoints). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JPA, MySQL driver and Flyway are deliberately NOT added yet: they
             arrive with T-02. Adding them now would make the app refuse to
             start without a database, which T-01 does not require. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Integration tests (*IT.java) run in the `verify` phase via
                 Failsafe; fast unit tests (*Test.java) run in `test` via
                 Surefire. Keeps `mvnw test` quick once the MySQL-backed
                 suites grow. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
